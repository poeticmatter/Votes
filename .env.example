# Set to true to disable HMR during development (useful in some environments)
# DISABLE_HMR=true

# Supabase credentials for asynchronous play.
# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). The anon/public key is safe to ship in the
# static bundle; never use the service_role key here.
#
# These are only required for the "Async (Supabase)" lobby mode. Live (P2P) play
# works without them. All lab games share one Supabase project, so these values are
# the same in every game repo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
